// Define o gerador do cliente
generator client {
  provider = "prisma-client-js"
}

// Define o banco de dados
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de Usuário
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  // Relacionamentos
  posts     Post[]
  comments  Comment[]

  @@map("users")
}

// Modelo de Post
model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  // Relacionamento com Autor
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  // Relacionamento com Comentários
  comments  Comment[]

  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  // Quem escreveu?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  // Em qual post?
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments") // Boa prática: manter o padrão de nomes de tabela
}