// Define o gerador do cliente
generator client {
  provider = "prisma-client-js"
}

// Define o banco de dados
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS NOVOS ---

enum Gender {
  MASCULINO
  FEMININO
  OUTRO
}

// Modelo de Usuário
model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  password           String
  role               String    @default("USER")
  createdAt          DateTime  @default(now())
  resetToken         String?   @unique
  resetTokenExpires  DateTime?
  
  // Novos campos para a Árvore
  gender             Gender    @default(OUTRO)
  birthDate          DateTime?

  // Relacionamentos
  posts              Post[]
  comments           Comment[]
  likes              Like[]
  
  // Vínculo com a Árvore Genealógica
  familyMember       FamilyMember? @relation(fields: [familyMemberId], references: [id])
  familyMemberId     String?       @unique

  @@map("users")
}

// Modelo para Membros da Família (Árvore)
// Permite cadastrar quem não tem conta (crianças, antepassados)
model FamilyMember {
  id        String    @id @default(uuid())
  name      String
  birthDate DateTime?
  gender    Gender    @default(OUTRO)
  isAlive   Boolean   @default(true)

  // RELAÇÕES PRIMÁRIAS (Auto-relacionamento)
  // Aqui é onde a mágica acontece: ligamos um membro a outro
  fatherId  String?
  motherId  String?
  spouseId  String?   @unique // Marido ou Esposa

  father    FamilyMember?  @relation("FatherToChildren", fields: [fatherId], references: [id])
  mother    FamilyMember?  @relation("MotherToChildren", fields: [motherId], references: [id])
  spouse    FamilyMember?  @relation("SpouseRelation", fields: [spouseId], references: [id])

  // Campos reversos necessários para o Prisma
  childrenOfFather FamilyMember[] @relation("FatherToChildren")
  childrenOfMother FamilyMember[] @relation("MotherToChildren")
  partner          FamilyMember?  @relation("SpouseRelation")

  // Link para a conta de usuário se ele existir
  user      User?

  @@map("family_members")
}

// Modelo de Post
model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  // Relacionamento com Autor
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  // Relacionamento com Comentários
  comments  Comment[]
  likes     Like[]

  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  // Quem escreveu?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  // Em qual post?
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Like {
  createdAt DateTime @default(now())

  // Relacionamento com Usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relacionamento com Post
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Chave Composta: Garante que um par User+Post seja único. 
  // O usuário não consegue dar 2 likes no mesmo post.
  @@id([userId, postId]) 
  
  @@map("likes")
}