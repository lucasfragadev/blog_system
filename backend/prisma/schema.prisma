// Define o gerador do cliente
generator client {
  provider = "prisma-client-js"
}

// Define o banco de dados
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Modelo de Usuário
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())

  // Relacionamentos
  posts     Post[]
  comments  Comment[]
  likes     Like[]

  @@map("users")
}

// Modelo de Post
model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  // Relacionamento com Autor
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  // Relacionamento com Comentários
  comments  Comment[]
  likes     Like[]

  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  // Quem escreveu?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  // Em qual post?
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Like {
  createdAt DateTime @default(now())

  // Relacionamento com Usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relacionamento com Post
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Chave Composta: Garante que um par User+Post seja único. 
  // O usuário não consegue dar 2 likes no mesmo post.
  @@id([userId, postId]) 
  
  @@map("likes")
}